{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/functions/v1/:path*",
      "destination": "https://xklwzkraobxetxdcysun.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/auth/v1/:path*",
      "destination": "https://xklwzkraobxetxdcysun.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/rest/v1/:path*",
      "destination": "https://xklwzkraobxetxdcysun.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/((?!assets|functions|auth|rest|favicon\\.ico|favicon\\.png|robots\\.txt|placeholder\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
